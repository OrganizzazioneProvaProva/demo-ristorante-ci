{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"core/**",
			"packages/**",
			"studio/**",
			"preset/**",
			"clienti/**",
			".claude/*.json",
			".mcp.json",
			"*.json",
			"!!**/dist",
			"!!**/.astro",
			"!!**/.sanity",
			"!**/public",
			"!**/schema.json",
			"!**/*.generated.css",
			"!**/sanity.types.ts",
			"!**/*.md",
			"!**/*.mdx"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
