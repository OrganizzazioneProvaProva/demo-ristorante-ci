---
/**
 * Casella di ricerca del catalogo (vedi `content/search.ts`). Resta nascosta finché lo script
 * non parte: senza JavaScript non c'è un controllo che non funziona e il catalogo si legge intero.
 * Il contenitore `target` contiene gli elementi `[data-search]` (e, se serve, i gruppi
 * `[data-search-group]`). Il testo di ricerca di ogni elemento lo scrive la nicchia.
 */
import type { Language } from "@siti/config";
import { SEARCH_LABELS } from "../content/search.ts";

interface Props {
	language: Language;
	/** `id` del contenitore del catalogo. */
	target: string;
	/** Etichetta della casella, scelta dalla nicchia ("Cerca nel menu"). */
	label: string;
}

const { language, target, label } = Astro.props;
const labels = SEARCH_LABELS[language];
const inputId = `${target}-search`;
---

<div
	hidden
	data-catalog-search
	data-target={target}
	data-many={labels.resultsMany}
	data-one={labels.resultsOne}
	data-none={labels.resultsNone}
	class="mx-auto max-w-5xl px-4 pt-8"
>
	<label for={inputId} class="font-semibold text-ink">{label}</label>
	<input
		id={inputId}
		type="search"
		autocomplete="off"
		class="mt-1 block w-full rounded-ui border-2 border-ink bg-bg px-3 py-2 text-ink"
	>
	<p role="status" data-search-status class="mt-2 text-sm text-muted"></p>
</div>

<script>
import "../scripts/catalog-search.ts";
import "../scripts/catalog-views.ts";
</script>
