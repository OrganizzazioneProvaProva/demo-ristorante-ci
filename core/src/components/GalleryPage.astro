---
import type { ComponentProps } from "astro/types";
import type { ResolvedImage } from "../content/images.ts";
import SiteLayout from "../layouts/SiteLayout.astro";
import Gallery from "./Gallery.astro";

interface Props {
	layout: ComponentProps<typeof SiteLayout>;
	images: ResolvedImage[];
}

const { layout, images } = Astro.props;
const { language, title } = layout;
---

<SiteLayout {...layout}>
	<div class="mx-auto max-w-5xl px-4 pt-8">
		<h1 class="font-display text-4xl font-bold text-ink">{title}</h1>
	</div>
	<Gallery images={images} language={language} hideTitle variant="mosaic" />
</SiteLayout>
