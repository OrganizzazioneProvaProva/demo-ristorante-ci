---
/**
 * Intestazione: nome dell'attività e navigazione. Sul telefono la navigazione è un pannello
 * `popover` nativo sotto l'intestazione (si apre con il pulsante a hamburger, che diventa una X; si
 * chiude con Esc, toccando fuori o con lo stesso pulsante: nessun JavaScript, e nessuno script inline,
 * 04); da `md` è una lista in linea. Nei
 * browser senza `popover` i link restano visibili in pagina.
 */
import type { NavItem, ShellLabels } from "../content/shell.ts";

interface Props {
	brand: string;
	homeHref: string;
	items: NavItem[];
	labels: Pick<ShellLabels, "menu" | "closeMenu" | "navigation">;
}

const { brand, homeHref, items, labels } = Astro.props;
---

<header
	data-site-header
	class="sticky top-0 z-20 border-b border-line bg-bg [view-transition-name:site-header]"
>
	<div
		class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3"
	>
		<a href={homeHref} class="font-display text-xl font-bold text-ink"
			>{brand}</a
		>
		<button
			type="button"
			popovertarget="site-menu"
			aria-label={labels.menu}
			data-menu-toggle
			class="inline-flex size-11 items-center justify-center rounded-ui border-2 border-ink text-ink md:hidden"
		>
			<span aria-hidden="true" class="relative block h-4 w-5">
				<span
					class="absolute inset-x-0 top-0 h-0.5 rounded-full bg-current"
				></span>
				<span
					class="absolute inset-x-0 top-[7px] h-0.5 rounded-full bg-current"
				></span>
				<span
					class="absolute inset-x-0 top-[14px] h-0.5 rounded-full bg-current"
				></span>
			</span>
		</button>
		<nav
			id="site-menu"
			popover
			aria-label={labels.navigation}
			class="fixed inset-x-0 top-[4.5rem] bottom-auto m-0 h-auto max-h-[80dvh] w-full overflow-y-auto border-0 bg-transparent p-0 md:static md:block md:max-h-none md:w-auto md:overflow-visible"
		>
			<div
				class="relative border-b border-line bg-bg p-4 md:border-0 md:bg-transparent md:p-0"
			>
				<ul class="grid gap-1 md:flex md:gap-6">
					{items.map((item) => (
						<li>
							<a
								href={item.href}
								data-nav-link
								aria-current={item.current ? "page" : undefined}
								class="block py-3 font-body text-lg font-semibold text-ink underline-offset-4 hover:underline aria-[current=page]:underline md:py-1 md:text-base"
							>
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		</nav>
	</div>
</header>

{/* Velo che oscura la pagina sotto l'intestazione mentre il menu del telefono è aperto (`menu.css`). */}
<div data-menu-veil aria-hidden="true"></div>

<script>
import "../scripts/header-scroll.ts";
</script>
