---
/**
 * Testimonianze: schede con virgolette, stelle (facoltative), citazione, iniziale, nome e ruolo.
 * Le scrive il titolare (vedi `content/testimonials.ts`). Le stelle hanno un testo alternativo
 * ("5 su 5"); l'avatar è l'iniziale del nome, decorativa. Un testo in un'altra lingua porta `lang`.
 */
import type { Language } from "@siti/config";
import { SECTION_LABELS } from "../content/section-labels.ts";
import type { ResolvedTestimonial } from "../content/testimonials.ts";

interface Props {
	testimonials: ResolvedTestimonial[];
	language: Language;
}

const { testimonials, language } = Astro.props;
const labels = SECTION_LABELS[language];
const stars = [1, 2, 3, 4, 5];
---

{testimonials.length > 0 && (
	<section
		id="testimonianze"
		aria-labelledby="testimonials-title"
		class="mx-auto max-w-5xl px-4 py-12"
	>
		<h2
			id="testimonials-title"
			data-reveal
			class="text-center font-display text-4xl font-bold text-ink"
		>
			{labels.testimonials}
		</h2>
		<ul class="mt-10 grid gap-6 md:grid-cols-3">
			{testimonials.map((item) => (
				<li data-card class="rounded-ui border border-line bg-surface p-6">
					<figure class="flex h-full flex-col">
						<svg
							aria-hidden="true"
							viewBox="0 0 24 24"
							class="size-10 text-accent"
							fill="currentColor"
						>
							<path d="M9.5 6C6.5 7 4 9.8 4 13.5V18h6v-6H7c0-1.7 1-3 3.2-3.8L9.5 6zm9 0c-3 1-5.5 3.8-5.5 7.5V18h6v-6h-3c0-1.7 1-3 3.2-3.8L18.5 6z" />
						</svg>
						{item.rating && (
							<span
								role="img"
								aria-label={labels.testimonialRating.replace(
									"{n}",
									String(item.rating),
								)}
								class="mt-3 flex gap-1 text-accent"
							>
								{stars.map((star) => (
									<svg
										aria-hidden="true"
										viewBox="0 0 24 24"
										class="size-5"
										fill={star <= (item.rating ?? 0) ? "currentColor" : "none"}
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linejoin="round"
									>
										<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3z" />
									</svg>
								))}
							</span>
						)}
						<blockquote lang={item.textLang} class="mt-4 flex-1 text-ink">
							<p>{item.text}</p>
						</blockquote>
						<figcaption class="mt-6 flex items-center gap-3">
							<span
								aria-hidden="true"
								class="flex size-12 shrink-0 items-center justify-center rounded-full bg-accent font-display text-xl font-bold text-accent-ink"
							>
								{item.initial}
							</span>
							<div>
								<p class="font-semibold text-ink">{item.author}</p>
								{item.role && <p class="text-sm text-muted">{item.role}</p>}
							</div>
						</figcaption>
					</figure>
				</li>
			))}
		</ul>
	</section>
)}
